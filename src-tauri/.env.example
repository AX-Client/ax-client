# AX Client - backend endpoints
# Empty AX_BACKEND_URL = stub mode (everything fails closed to free, cloud
# sync writes locally to data_dir/cloud).
#
# Supabase setup:
#   1. create a project at https://supabase.com
#   2. run supabase/schema.sql in the SQL editor
#   3. deploy the Edge Functions (supabase/functions/*) via the Supabase CLI
#   4. AX_BACKEND_URL=https://<project-ref>.supabase.co/functions/v1
AX_BACKEND_URL=

# Endpoint paths, defaulting to the Supabase Edge Function slugs (only needed
# if you renamed the functions or use a custom backend)
AX_ENDPOINT_IDENTIFY=/auth-identify
AX_ENDPOINT_REFRESH=/auth-refresh
AX_ENDPOINT_STATUS=/premium-status
AX_ENDPOINT_CLOUD=/cloud-sync

# paywall / affiliate links opened in the standard browser
AX_PAYWALL_URL=
AX_AFFILIATE_URL=

# dev-only: fake premium tier so the UI can be tested without a backend
AX_PREMIUM_MOCK=false

# session token lifetime in seconds before the client asks the backend for a refresh
AX_SESSION_TTL_SECS=600
